<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="manifest" href="/manifest.json">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="All Aboard">
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="192x192" href="/assets/icon-192.png">
<title>{{ title or "All Aboard Contractors | Site work, concrete and demolition in Houston" }}</title>
<meta name="description" content="{{ description or "All Aboard Contractors is a family-owned, WBE and SBE certified Houston contractor for land clearing, demolition, concrete, fencing, tree services, landscaping and property preservation. Call (281) 938-9550 for a free estimate." }}">
<link rel="canonical" href="{{ site.domain }}{{ page.url }}">
<meta property="og:type" content="website">
<meta property="og:title" content="{% if title %}{{ title }} | All Aboard Contractors{% else %}All Aboard Contractors | Houston site work, concrete and demolition{% endif %}">
<meta property="og:description" content="{{ description or "Certified WBE and SBE contractor serving Houston and surrounding areas. Concrete, fencing, landscaping, demolition and more. Free estimates." }}">
<meta property="og:url" content="{{ site.domain }}{{ page.url }}">
<meta property="og:image" content="{{ site.domain }}/images/og-image.png">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{% if title %}{{ title }} | All Aboard Contractors{% else %}All Aboard Contractors | Houston site work, concrete and demolition{% endif %}">
<meta name="twitter:description" content="{{ description or "Certified WBE and SBE contractor serving Houston and surrounding areas. Concrete, fencing, landscaping, demolition and more. Free estimates." }}">
<meta name="twitter:image" content="{{ site.domain }}/images/og-image.png">
<meta name="theme-color" content="#1A4B9B">
{% include "favicon.njk" %}
<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400..700&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/style.css">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "GeneralContractor",
  "name": "All Aboard Contractors",
  "url": "https://www.allaboardcontractors.com/",
  "logo": "https://www.allaboardcontractors.com/images/logo-full.png",
  "telephone": "+1-281-938-9550",
  "email": "shantekelley@allaboardcontractors.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "3218 Rockrill Dr.",
    "addressLocality": "Houston",
    "addressRegion": "TX",
    "postalCode": "77045",
    "addressCountry": "US"
  },
  "areaServed": ["Houston, TX", "Greater Houston", "Texas"],
  "sameAs": ["https://www.facebook.com/allaboardcontractors","https://www.instagram.com/allaboardcontractors/","https://www.linkedin.com/company/102140875/"]
}
</script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
{% include "sprite.njk" %}

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label="All Aboard Contractors, home">
      {% include "logo-header.njk" %}
      <span class="brand__name">All Aboard<span>Contractors</span></span>
    </a>
    <nav class="nav" id="nav" aria-label="Main">
      <a href="/#company">Company</a>
      <a href="/#expertise">Expertise</a>
      <a href="/#work">Projects</a>
      <a href="/before-and-after/">Before &amp; After</a>
      <a href="/reviews/">Reviews</a>
      <a href="/#contact">Contact</a>
      <a href="/book-an-estimate/">Book an estimate</a>
      <a href="/invite-us-to-bid/">Invite us to bid</a>
      <a href="/login/">Log in</a>
      <div class="nav-drop">
        <button class="nav-drop__btn" type="button" aria-expanded="false" aria-controls="nav-more">More</button>
        <div class="nav-drop__menu" id="nav-more">
          <a href="/#process">Process</a>
          <a href="/#faq">FAQ</a>
        </div>
      </div>
    </nav>
    <a class="btn btn--blue header-call" href="tel:{{ site.phone_main_tel }}">Call<span>&nbsp;{{ site.phone_main }}</span></a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="nav">Menu</button>
  </div>
</header>

<main id="main">
{% block content %}{% endblock %}
</main>

<footer class="site-footer">
  <svg class="topo" aria-hidden="true"><use href="#topo"/></svg>
  <div class="wrap">
    <div class="footer-lead">
      <div>
        <h2>{{ homepage.footer_lead.heading }}</h2>
        <p>{{ homepage.footer_lead.text }}</p>
      </div>
      <div class="footer-lead__cta">
        <a class="btn btn--yellow" href="/book-an-estimate/">Book a free estimate</a>
        <a class="btn btn--ghost" href="tel:{{ site.phone_main_tel }}">Call {{ site.phone_main }}</a>
      </div>
    </div>
    <div class="footer-grid">
      <div>
        <a class="brand" href="/" aria-label="All Aboard Contractors, back to top">
          {% include "logo-footer.njk" %}
          <span class="brand__name">All Aboard<span>Contractors</span></span>
        </a>
        <p class="footer-tag">{{ site.tagline }}</p>
      </div>
      <div>
        <h3>What we do</h3>
        <ul>
          <li><a href="/#expertise">Expertise</a></li>
          <li><a href="/#services">All services</a></li>
          <li><a href="/#work">Projects</a></li>
          <li><a href="/before-and-after/">Before &amp; After</a></li>
          <li><a href="/#process">Process</a></li>
        </ul>
      </div>
      <div>
        <h3>Contact</h3>
        <ul>
          <li><a href="tel:{{ site.phone_main_tel }}">{{ site.phone_main }}</a></li>
          <li><a href="tel:{{ site.phone_second_tel }}">{{ site.phone_second }}</a></li>
          <li><a href="mailto:{{ site.email }}">Email us</a></li>
          <li>{{ site.office_street }}<br>{{ site.office_city }}</li>
        </ul>
      </div>
      <div>
        <h3>Follow</h3>
        <ul>
          <li><a href="{{ site.facebook }}" rel="noopener">Facebook</a></li>
          <li><a href="{{ site.instagram }}" rel="noopener">Instagram</a></li>
          <li><a href="{{ site.linkedin }}" rel="noopener">LinkedIn</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-base">
      <span>&copy; <span id="year">2026</span> All Aboard Contractors. All rights reserved.</span>
      <span>Houston, Texas</span>
    </div>
  </div>
</footer>

<script src="/assets/js/main.js"></script>
<script>
/* Sends the site owner to the editor after accepting an invite or logging in */
if (window.netlifyIdentity) {
  netlifyIdentity.on("init", function (user) {
    if (!user) { netlifyIdentity.on("login", function () { document.location.href = "/admin/"; }); }
  });
}
</script>
</body>
</html>
