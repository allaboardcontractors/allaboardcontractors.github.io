{% extends "layouts/base.njk" %}

{% block content %}
<section class="page-head">
  <div class="wrap">
    <h1>{{ title }}</h1>
    {% if intro %}<p>{{ intro }}</p>{% endif %}
  </div>
</section>

<section class="section" id="testimonials">
  <div class="wrap">
    <div class="section-head">
      <h2>{{ homepage.testimonials.heading }}</h2>
      <p>Real reviews from real customers, newest first.</p>
    </div>
    {% if homepage.testimonials.items and homepage.testimonials.items | length %}
    <ul class="quotes">
      {% for item in homepage.testimonials.items %}
      <li class="quote">
        <blockquote>{{ item.quote }}</blockquote>
        <p class="quote__name">{{ item.name }}</p>
        <p class="quote__job">{{ item.job }}</p>
      </li>
      {% endfor %}
    </ul>
    {% endif %}
    <ul class="quotes" id="client-reviews" data-csv="{{ site.reviews_csv_url }}"></ul>
    <p class="review-note" id="review-note">Loading our latest reviews.</p>
    <div class="review-form-wrap" id="leave-a-review">
      <h3>Leave a review</h3>
      <p>Had work done by All Aboard Contractors? Tell us how it went.</p>
      <form class="form" id="review-form">
        <div class="form__grid">
          <div class="field">
            <label for="r-name">Your name</label>
            <input id="r-name" name="Your name" type="text" autocomplete="name" required>
          </div>
          <div class="field">
            <label for="r-city">City</label>
            <input id="r-city" name="City" type="text" autocomplete="address-level2">
          </div>
          <div class="field">
            <label for="r-work">What work did we do for you?</label>
            <select id="r-work" name="What work did we do for you?" required>
              <option value="">Choose the work</option>
              <option>Concrete</option>
              <option>Fencing</option>
              <option>Gates</option>
              <option>Driveway</option>
              <option>Demolition</option>
              <option>Landscaping</option>
              <option>Other</option>
            </select>
          </div>
          <div class="field">
            <label for="r-stars">How many stars?</label>
            <select id="r-stars" name="How many stars?" required>
              <option value="">Choose stars</option>
              <option value="5">5 stars</option>
              <option value="4">4 stars</option>
              <option value="3">3 stars</option>
              <option value="2">2 stars</option>
              <option value="1">1 star</option>
            </select>
          </div>
          <div class="field field--full">
            <label for="r-review">Your review</label>
            <textarea id="r-review" name="Your review" required></textarea>
          </div>
        </div>
        <button class="btn btn--yellow" type="submit">Submit your review</button>
        <p class="form__status" id="review-sent" hidden>Thank you. Your review was sent. It will show on this page after it is posted.</p>
        <p class="form__status" id="review-error" hidden>Sorry, your review did not send. Please try again.</p>
      </form>
    </div>
  </div>
</section>
{% endblock %}
